# Copy this file to .env and fill in your own values.
# .env is already listed in .gitignore, so it will never be committed.

# --- Required ---

# AviationStack API key (https://aviationstack.com/) — powers flight_agent's
# live flight search in tools/flight_tool.py.
AVIATIONSTACK_API_KEY=
# Groq API key (https://console.groq.com/) — used for every LLM call
# (itinerary_agent and final_agent), see agent/config.py.
GROQ_API_KEY=

# Tavily API key (https://tavily.com/) — powers hotel_agent's web search
# in tools/tavily_tool.py.
TAVILY_API_KEY=

# PostgreSQL connection string used for LangGraph's conversation-memory
# checkpointer (see agent/graph.py). If you're using Render's managed
# Postgres, this is the "External Database URL" from your Render dashboard.
DATABASE_URL=

# --- Optional: LangSmith tracing/observability (https://smith.langchain.com/) ---
# Leave these blank to run without tracing. Set them to see a visual trace
# of every agent step and LLM call for a given request, which is very
# useful while learning how the LangGraph pipeline behaves.

LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=

# --- Optional ---

# Default departure airport (IATA code) used by tools/flight_tool.py when a
# travel request only mentions a destination, e.g. "flights to Tokyo" with
# no origin given. Defaults to TPE (Taipei) in code if left blank.
DEFAULT_ORIGIN_IATA=
